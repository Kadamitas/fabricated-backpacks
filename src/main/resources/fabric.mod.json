  "authors": ["Kadamitas"],
  "contact": {
    "sources": "https://github.com/Kadamitas/fabricated-backpacks",
    "issues": "https://github.com/Kadamitas/fabricated-backpacks/issues"
  },
  "license": "MIT",
  "icon": "assets/fabricated_backpacks/icon.png",
  "environment": "*",
  "entrypoints": {
    "main": ["com.kadamitas.fabricatedbackpacks.FabricatedBackpacks"],
    "client": ["com.kadamitas.fabricatedbackpacks.client.FabricatedBackpacksClient"]
  },
  "mixins": ["fabricated_backpacks.mixins.json", {"config":"fabricated_backpacks.client.mixins.json","environment":"client"}],
  "depends": {
    "fabricloader": ">=0.19.3",
    "minecraft": "26.2",
    "java": ">=25",
    "fabric-api": ">=0.158.0+26.2",
